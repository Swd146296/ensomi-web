{
  "name": "@ensomi/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "fflate": "0.8.2",
    "onnxruntime-web": "1.23.2"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "onnxruntime-node": "1.23.2",
    "playwright": "1.54.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "parity": "node --import tsx checks/parity.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:site": "esbuild ../../site/app.ts ../../site/worker.ts --bundle --format=esm --target=es2022 --minify --outdir=../../public --log-level=warning",
    "typecheck:site": "tsc -p ../../site",
    "serve:site": "node ../../site/serve.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ]
}
